ocio_profile_version: 2.5

environment:
  {}
search_path: ""
strictparsing: true
luma: [0.2126, 0.7152, 0.0722]

roles:
  {}

file_rules:
  - !<Rule> {name: Default, colorspace: default}

displays:
  {}

active_displays: []
active_views: []

colorspaces:
  - !<ColorSpace>
    name: t0000
    family: ""
    equalitygroup: ""
    bitdepth: unknown
    isdata: false
    allocation: uniform
    to_scene_reference: !<GradingPrimaryTransform> {style: log}

  - !<ColorSpace>
    name: t0001
    family: ""
    equalitygroup: ""
    bitdepth: unknown
    isdata: false
    allocation: uniform
    to_scene_reference: !<GradingPrimaryTransform>
      style: log
      brightness: {rgb: [0.1, 0.9, 1.2], master: 1.05}
      contrast: {rgb: [1.11, 0.91, 1.21], master: 1.06}
      gamma: {rgb: [1.12, 0.92, 1.22], master: 1.07}
      saturation: 1.3
      pivot: {contrast: 0.123456789, black: 0.05, white: 0.95}
      clamp: {black: -0.1, white: 1.2}

