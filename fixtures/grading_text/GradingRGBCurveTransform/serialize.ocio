ocio_profile_version: 2.5

environment:
  {}
search_path: ""
strictparsing: true
luma: [0.2126, 0.7152, 0.0722]

roles:
  {}

file_rules:
  - !<Rule> {name: Default, colorspace: default}

displays:
  {}

active_displays: []
active_views: []

colorspaces:
  - !<ColorSpace>
    name: t0000
    family: ""
    equalitygroup: ""
    bitdepth: unknown
    isdata: false
    allocation: uniform
    to_scene_reference: !<GradingRGBCurveTransform> {style: log}

  - !<ColorSpace>
    name: t0001
    family: ""
    equalitygroup: ""
    bitdepth: unknown
    isdata: false
    allocation: uniform
    to_scene_reference: !<GradingRGBCurveTransform>
      style: log
      red: {control_points: [0, 0, 0.5, 0.6, 1, 1]}
      green: {control_points: [0, 0, 0.4, 0.5, 1, 1]}
      blue: {control_points: [0, 0.05, 0.5, 0.5, 1, 1]}
      master: {control_points: [0, 0, 0.5, 0.5, 1, 0.95], slopes: [0, 1.25, 0]}

