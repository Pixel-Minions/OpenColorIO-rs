ocio_profile_version: 2.5

environment:
  {}
search_path: ""
strictparsing: true
luma: [0.2126, 0.7152, 0.0722]

roles:
  {}

file_rules:
  - !<Rule> {name: Default, colorspace: default}

displays:
  {}

active_displays: []
active_views: []

colorspaces:
  - !<ColorSpace>
    name: t0000
    family: ""
    equalitygroup: ""
    bitdepth: unknown
    isdata: false
    allocation: uniform
    to_scene_reference: !<GradingHueCurveTransform> {style: log}

  - !<ColorSpace>
    name: t0001
    family: ""
    equalitygroup: ""
    bitdepth: unknown
    isdata: false
    allocation: uniform
    to_scene_reference: !<GradingHueCurveTransform>
      style: log
      hue_hue: {control_points: [0, 0, 0.1666667, 0.2, 0.3333333, 0.3333333, 0.5, 0.5, 0.6666667, 0.6666667, 0.8333333, 0.8333333]}
      hue_sat: {control_points: [0, 1, 0.1666667, 1, 0.3333333, 1.2, 0.5, 1, 0.6666667, 1, 0.8333333, 1]}
      lum_sat: {control_points: [0, 1.1, 0.5, 1, 1, 1]}
      sat_sat: {control_points: [0, 0, 0.5, 0.55, 1, 1], slopes: [0, 1.2, 0]}
      lum_lum: {control_points: [0, 0, 0.5, 0.45, 1, 1]}
