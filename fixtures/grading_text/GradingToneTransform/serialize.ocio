      style: log
      blacks: {rgb: [1.1, 0.9, 1.2], master: 1.05, start: 0.4, width: 0.4}
      shadows: {rgb: [1.08, 0.88, 1.18], master: 1.03, start: 0.5, pivot: 0}
      midtones: {rgb: [1.06, 0.86, 1.16], master: 1.01, center: 0.4, width: 0.6}
      highlights: {rgb: [1.04, 0.84, 1.14], master: 0.99, start: 0.3, pivot: 1}
