ocio_profile_version: 2.5

environment:
  {}
search_path:
  - plain
  - " lead"
  - "trail "
  - "a: b"
  - "a #b"
  - a#b
  - e#
  - x#
  - "x #"
  - "#"
  - -dash
  - "- x"
strictparsing: true
family_separator: " "
luma: [0.2126, 0.7152, 0.0722]
name: "a: config #1"

roles:
  {}

file_rules:
  - !<Rule> {name: Default, colorspace: default}

displays:
  {}

active_displays: []
active_views: []

colorspaces:
  - !<ColorSpace>
    name: cs0
    family: plain
    equalitygroup: ""
    bitdepth: unknown
    isdata: false
    encoding: plain
    allocation: uniform

  - !<ColorSpace>
    name: cs1
    family: " lead"
