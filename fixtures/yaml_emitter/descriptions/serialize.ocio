ocio_profile_version: 2.5

environment:
  {}
search_path: ""
strictparsing: true
family_separator: a
luma: [0.2126, 0.7152, 0.0722]
description: |
  Config description

  Second paragraph: with a colon.

roles:
  {}

file_rules:
  - !<Rule> {name: Default, colorspace: default}

displays:
  d:
    - !<View> {name: v0, colorspace: cs0, description: one line}
    - !<View> {name: v1, colorspace: cs0, description: "a\nb"}
    - !<View> {name: v2, colorspace: cs0, description: "a\nb"}
    - !<View> {name: v3, colorspace: cs0, description: "a\nb"}
    - !<View> {name: v4, colorspace: cs0, description: "\na"}
    - !<View> {name: v5, colorspace: cs0, description: "\n\na"}
    - !<View> {name: v6, colorspace: cs0, description: "a\n\n\nb"}
    - !<View> {name: v7, colorspace: cs0, description: "a \nb"}
    - !<View> {name: v8, colorspace: cs0, description: "a\n \nb"}
    - !<View> {name: v9, colorspace: cs0, description: "\t\nx"}
    - !<View> {name: v10, colorspace: cs0, description: "x\n\ty"}
    - !<View> {name: v11, colorspace: cs0, description: "tab\there\nx"}
    - !<View> {name: v12, colorspace: cs0, description: "a\n  b\n    c"}
    - !<View> {name: v13, colorspace: cs0, description: "- item\n- item2"}
    - !<View> {name: v14, colorspace: cs0, description: "k: v\nx"}
    - !<View> {name: v15, colorspace: cs0, description: "# not a comment\nx"}
    - !<View> {name: v16, colorspace: cs0, description: "x\n#hash"}
    - !<View> {name: v17, colorspace: cs0, description: "x\n---\ny"}
    - !<View> {name: v18, colorspace: cs0, description: "x\n...\ny"}
    - !<View> {name: v19, colorspace: cs0, description: x}
    - !<View> {name: v20, colorspace: cs0, description: ""}
    - !<View> {name: v21, colorspace: cs0, description: ""}
    - !<View> {name: v22, colorspace: cs0, description: "trailing space "}
    - !<View> {name: v23, colorspace: cs0, description: " "}
    - !<View> {name: v24, colorspace: cs0, description: a\nb}
    - !<View> {name: v25, colorspace: cs0, description: "café\n日本"}
    - !<View> {name: v26, colorspace: cs0, description: "a b\nc"}
    - !<View> {name: v27, colorspace: cs0, description: "x\n\xa0nbsp"}
    - !<View> {name: v28, colorspace: cs0, description: "x\n\x01ctl"}
    - !<View> {name: v29, colorspace: cs0, description: "k: v"}
    - !<View> {name: v30, colorspace: cs0, description: "# c"}
    - !<View> {name: v31, colorspace: cs0, description: "line with \"quotes\"\nand 'single'"}
    - !<View> {name: v32, colorspace: cs0, description: "\ny"}

active_displays: []
active_views: []

colorspaces:
  - !<ColorSpace>
    name: cs0
    family: ""
    equalitygroup: ""
    bitdepth: unknown
    description: one line
    isdata: false
    interchange:
      amf_transform_ids: one line
    allocation: uniform

  - !<ColorSpace>
    name: cs1
    family: ""
    equalitygroup: ""
    bitdepth: unknown
    description: |
      a
      b
    isdata: false
    interchange:
      amf_transform_ids: |
        a
        b
    allocation: uniform

  - !<ColorSpace>
    name: cs2
    family: ""
    equalitygroup: ""
    bitdepth: unknown
    description: |
      a
      b
    isdata: false
    interchange:
