  - !<ColorSpace>
    name: cs3
    family: phxq0003
    equalitygroup: ""
    bitdepth: unknown
    description: phxq0019
    isdata: false
    encoding: phxq0011
    allocation: uniform

  - !<ColorSpace>
    name: cs4
    family: phxq0004
    equalitygroup: ""
    bitdepth: unknown
    description: phxq0020
    isdata: false
    encoding: phxq0012
    allocation: uniform

  - !<ColorSpace>
    name: cs5
    family: phxq0005
    equalitygroup: ""
    bitdepth: unknown
